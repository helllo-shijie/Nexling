{
  "schema_version": "glossary-package/v1",
  "pack_id": "compilers-programming-languages",
  "name": "编译原理与程序语言",
  "description": "词法语法分析、中间表示、优化、运行时与类型系统常用术语；英译中单向，共 141 条。",
  "version": "1.0.0",
  "langs": ["en", "zh-Hans"],
  "domain": "compilers",
  "license": "CC-BY-4.0",
  "attribution": "NexLing community glossary",
  "entry_count": 141,
  "entries": [
    { "source_term": "lexical analysis", "target_term": "词法分析", "domain": "compilers", "definition": "把字符流切分为词法单元的分析阶段。" },
    { "source_term": "tokenizer", "target_term": "词法分析器", "domain": "compilers", "definition": "执行词法分析、输出词法单元序列的组件。" },
    { "source_term": "lexeme", "target_term": "词素", "domain": "compilers", "definition": "源码中与某个词法单元模式匹配的字符序列。" },
    { "source_term": "regular expression", "target_term": "正则表达式", "domain": "compilers", "definition": "描述正则语言的形式化记法，常用于词法规则。" },
    { "source_term": "finite automaton", "target_term": "有限自动机", "domain": "compilers", "definition": "由有限状态与转移构成、识别正则语言的模型。" },
    { "source_term": "nondeterministic finite automaton", "target_term": "非确定性有限自动机", "domain": "compilers", "definition": "同一状态对同一输入可有多个转移，即 NFA。" },
    { "source_term": "deterministic finite automaton", "target_term": "确定性有限自动机", "domain": "compilers", "definition": "每个状态对每个输入至多一个转移，即 DFA。" },
    { "source_term": "Thompson construction", "target_term": "汤普森构造法", "domain": "compilers", "definition": "按正则表达式结构递归构造 NFA 的算法。" },
    { "source_term": "subset construction", "target_term": "子集构造法", "domain": "compilers", "definition": "以状态集合为 DFA 状态，把 NFA 确定化。" },
    { "source_term": "parsing", "target_term": "语法分析", "domain": "compilers", "definition": "按文法判断词法单元序列结构并构建语法树。" },
    { "source_term": "context-free grammar", "target_term": "上下文无关文法", "domain": "compilers", "definition": "产生式左部为单个非终结符的形式文法。" },
    { "source_term": "Backus-Naur form", "target_term": "巴科斯-瑙尔范式", "domain": "compilers", "definition": "描述上下文无关文法的标准记法，即 BNF。" },
    { "source_term": "production rule", "target_term": "产生式", "domain": "compilers", "definition": "规定非终结符如何展开为符号序列的规则。" },
    { "source_term": "leftmost derivation", "target_term": "最左推导", "domain": "compilers", "definition": "每一步都展开最左侧非终结符的推导。" },
    { "source_term": "parse tree", "target_term": "语法分析树", "domain": "compilers", "definition": "以树形表示推导过程、保留全部语法细节。" },
    { "source_term": "abstract syntax tree", "target_term": "抽象语法树", "domain": "compilers", "definition": "省略标点等细节、只保留语义结构的树，即 AST。" },
    { "source_term": "recursive descent parser", "target_term": "递归下降解析器", "domain": "compilers", "definition": "为每个非终结符写一个递归函数的自顶向下解析器。" },
    { "source_term": "LL parser", "target_term": "LL 解析器", "domain": "compilers", "definition": "从左到右读入、最左推导、向前看 k 个词法单元。" },
    { "source_term": "LR parser", "target_term": "LR 解析器", "domain": "compilers", "definition": "从左到右读入、最右推导逆序的自底向上解析器。" },
    { "source_term": "LALR parser", "target_term": "LALR 解析器", "domain": "compilers", "definition": "合并 LR(1) 同心项目集、兼顾表大小与能力的解析器。" },
    { "source_term": "shift-reduce conflict", "target_term": "移进-归约冲突", "domain": "compilers", "definition": "解析器无法决定继续读入还是立即归约。" },
    { "source_term": "reduce-reduce conflict", "target_term": "归约-归约冲突", "domain": "compilers", "definition": "解析器可用多个产生式归约同一句柄。" },
    { "source_term": "operator precedence parser", "target_term": "算符优先解析器", "domain": "compilers", "definition": "依据运算符优先级与结合性决定归约时机。" },
    { "source_term": "associativity", "target_term": "结合性", "domain": "compilers", "definition": "同级运算符从左还是从右结合。" },
    { "source_term": "left recursion", "target_term": "左递归", "domain": "compilers", "definition": "产生式左部非终结符在右部最左位置递归出现。" },
    { "source_term": "left factoring", "target_term": "提取左公因子", "domain": "compilers", "definition": "把多个产生式的公共前缀提出以消除回溯。" },
    { "source_term": "FIRST set", "target_term": "FIRST 集合", "domain": "compilers", "definition": "某符号串可能推导出的首终结符集合。" },
    { "source_term": "FOLLOW set", "target_term": "FOLLOW 集合", "domain": "compilers", "definition": "某非终结符之后可能出现的终结符集合。" },
    { "source_term": "parser generator", "target_term": "解析器生成器", "domain": "compilers", "definition": "根据文法自动生成解析代码的工具，如 yacc。" },
    { "source_term": "semantic analysis", "target_term": "语义分析", "domain": "compilers", "definition": "检查类型、作用域与语义约束的阶段。" },
    { "source_term": "symbol table", "target_term": "符号表", "domain": "compilers", "definition": "记录标识符类型、作用域与地址的数据结构。" },
    { "source_term": "scope resolution", "target_term": "作用域解析", "domain": "compilers", "definition": "确定标识符引用绑定到哪个声明。" },
    { "source_term": "type checking", "target_term": "类型检查", "domain": "compilers", "definition": "验证操作与表达式类型是否合法。" },
    { "source_term": "type inference", "target_term": "类型推断", "domain": "compilers", "definition": "在缺少显式标注时自动推导表达式类型。" },
    { "source_term": "Hindley-Milner type system", "target_term": "欣德利-米尔纳类型系统", "domain": "compilers", "definition": "支持参数多态与完整类型推断的类型系统。" },
    { "source_term": "polymorphic type", "target_term": "多态类型", "domain": "compilers", "definition": "可对多种具体类型统一实例化的类型。" },
    { "source_term": "type erasure", "target_term": "类型擦除", "domain": "compilers", "definition": "编译后移除泛型类型参数信息。" },
    { "source_term": "monomorphization", "target_term": "单态化", "domain": "compilers", "definition": "为每组具体类型参数生成专用代码；勿与数学“单态射”混淆。" },
    { "source_term": "intermediate representation", "target_term": "中间表示", "domain": "compilers", "definition": "源语言与目标机器之间的抽象程序形式，即 IR。" },
    { "source_term": "three-address code", "target_term": "三地址码", "domain": "compilers", "definition": "每条指令至多一个运算符与三个操作数的 IR。" },
    { "source_term": "static single assignment form", "target_term": "静态单赋值形式", "domain": "compilers", "definition": "每个变量只被赋值一次、便于数据流分析的 IR，即 SSA。" },
    { "source_term": "basic block", "target_term": "基本块", "domain": "compilers", "definition": "只有入口和出口、内部无分支的指令序列。" },
    { "source_term": "control-flow graph", "target_term": "控制流图", "domain": "compilers", "definition": "以基本块为节点、跳转为边的图，即 CFG。" },
    { "source_term": "data-flow analysis", "target_term": "数据流分析", "domain": "compilers", "definition": "在控制流图上迭代传播事实的静态分析框架。" },
    { "source_term": "reaching definitions", "target_term": "到达定值", "domain": "compilers", "definition": "某点可能到达的、未被重新赋值的定义集合。" },
    { "source_term": "liveness analysis", "target_term": "活跃性分析", "domain": "compilers", "definition": "判断变量在某点之后是否还会被使用。" },
    { "source_term": "register allocation", "target_term": "寄存器分配", "domain": "compilers", "definition": "把虚拟寄存器映射到有限物理寄存器。" },
    { "source_term": "graph coloring", "target_term": "图着色", "domain": "compilers", "definition": "以冲突图着色近似求解寄存器分配。" },
    { "source_term": "register spilling", "target_term": "寄存器溢出", "domain": "compilers", "definition": "寄存器不足时把变量暂存到栈上。" },
    { "source_term": "instruction selection", "target_term": "指令选择", "domain": "compilers", "definition": "把 IR 映射为目标机器指令。" },
    { "source_term": "instruction scheduling", "target_term": "指令调度", "domain": "compilers", "definition": "重排指令以隐藏延迟、减少停顿。" },
    { "source_term": "peephole optimization", "target_term": "窥孔优化", "domain": "compilers", "definition": "在局部指令窗口内做模式替换优化。" },
    { "source_term": "constant folding", "target_term": "常量折叠", "domain": "compilers", "definition": "编译期直接计算常量表达式。" },
    { "source_term": "constant propagation", "target_term": "常量传播", "domain": "compilers", "definition": "把已知常量值替换到使用处。" },
    { "source_term": "dead code elimination", "target_term": "死代码消除", "domain": "compilers", "definition": "删除结果永不被使用或无副作用的代码。" },
    { "source_term": "common subexpression elimination", "target_term": "公共子表达式消除", "domain": "compilers", "definition": "复用已计算的相同表达式结果。" },
    { "source_term": "loop-invariant code motion", "target_term": "循环不变量外提", "domain": "compilers", "definition": "把循环内不变的计算移到循环外。" },
    { "source_term": "strength reduction", "target_term": "强度削弱", "domain": "compilers", "definition": "用更便宜的运算替换昂贵运算，如乘法改移位。" },
    { "source_term": "tail call optimization", "target_term": "尾调用优化", "domain": "compilers", "definition": "尾位置调用复用当前栈帧，避免栈增长。" },
    { "source_term": "function inlining", "target_term": "函数内联", "domain": "compilers", "definition": "把被调函数体直接展开到调用处。" },
    { "source_term": "devirtualization", "target_term": "去虚化", "domain": "compilers", "definition": "确定动态分派目标后改为直接调用。" },
    { "source_term": "escape analysis", "target_term": "逃逸分析", "domain": "compilers", "definition": "判断对象是否逃出当前函数或线程，以决定栈分配或消除同步。" },
    { "source_term": "alias analysis", "target_term": "别名分析", "domain": "compilers", "definition": "判断两个指针是否可能指向同一对象。" },
    { "source_term": "strict aliasing", "target_term": "严格别名", "domain": "compilers", "definition": "规定不同类型指针不得访问同一对象的优化假设。" },
    { "source_term": "pointer analysis", "target_term": "指针分析", "domain": "compilers", "definition": "静态推断指针可能指向对象的集合。" },
    { "source_term": "call graph", "target_term": "调用图", "domain": "compilers", "definition": "以函数为节点、调用关系为边的图。" },
    { "source_term": "virtual dispatch", "target_term": "虚方法分派", "domain": "compilers", "definition": "运行时按对象实际类型选择方法实现。" },
    { "source_term": "virtual method table", "target_term": "虚方法表", "domain": "compilers", "definition": "存放各虚方法地址、供动态分派查表的数组。" },
    { "source_term": "thunk", "target_term": "形实转换程序", "domain": "compilers", "definition": "为适配调用约定或延迟计算而生成的小段跳转代码。" },
    { "source_term": "closure conversion", "target_term": "闭包转换", "domain": "compilers", "definition": "把带自由变量的函数改写为显式传入环境。" },
    { "source_term": "lambda lifting", "target_term": "λ 提升", "domain": "compilers", "definition": "把嵌套函数提升到顶层并把自由变量变为参数。" },
    { "source_term": "continuation-passing style", "target_term": "续延传递风格", "domain": "compilers", "definition": "把“后续计算”作为显式参数传递的编程风格，即 CPS。" },
    { "source_term": "reference counting", "target_term": "引用计数", "domain": "compilers", "definition": "通过计数归零判断对象可回收。" },
    { "source_term": "tracing garbage collector", "target_term": "追踪式垃圾回收器", "domain": "compilers", "definition": "从根集合出发遍历可达对象、回收其余对象。" },
    { "source_term": "generational collection", "target_term": "分代回收", "domain": "compilers", "definition": "按对象年龄分代、优先回收年轻代。" },
    { "source_term": "write barrier", "target_term": "写屏障", "domain": "compilers", "definition": "在指针写入时插入、用于维护回收器元数据的代码。" },
    { "source_term": "mark-and-sweep", "target_term": "标记-清除", "domain": "compilers", "definition": "先标记可达对象，再清扫未标记对象。" },
    { "source_term": "copying collection", "target_term": "复制式回收", "domain": "compilers", "definition": "把存活对象复制到另一半空间并整体回收原空间。" },
    { "source_term": "bump allocator", "target_term": "线性分配器", "domain": "compilers", "definition": "仅移动空闲指针即可分配、回收时整体重置。" },
    { "source_term": "arena allocation", "target_term": "区域分配", "domain": "compilers", "definition": "从区域一次性分配、结束时整体释放。" },
    { "source_term": "stack frame", "target_term": "栈帧", "domain": "compilers", "definition": "函数调用时在栈上分配的局部变量与返回地址区域。" },
    { "source_term": "calling convention", "target_term": "调用约定", "domain": "compilers", "definition": "规定参数传递、返回值与寄存器保存责任的约定。" },
    { "source_term": "application binary interface", "target_term": "应用二进制接口", "domain": "compilers", "definition": "规定二进制层面调用、数据布局与链接的接口，即 ABI。" },
    { "source_term": "register pressure", "target_term": "寄存器压力", "domain": "compilers", "definition": "某点同时活跃的变量数对寄存器的需求。" },
    { "source_term": "just-in-time compilation", "target_term": "即时编译", "domain": "compilers", "definition": "运行时把热点代码编译为机器码，即 JIT。" },
    { "source_term": "ahead-of-time compilation", "target_term": "提前编译", "domain": "compilers", "definition": "运行前完成全部编译，即 AOT。" },
    { "source_term": "bytecode", "target_term": "字节码", "domain": "compilers", "definition": "面向虚拟机的紧凑中间指令格式。" },
    { "source_term": "interpreter", "target_term": "解释器", "domain": "compilers", "definition": "逐条读取并执行程序、不预先生成机器码。" },
    { "source_term": "virtual machine", "target_term": "虚拟机", "domain": "compilers", "definition": "执行字节码并提供运行时服务的抽象机器。" },
    { "source_term": "deoptimization", "target_term": "去优化", "domain": "compilers", "definition": "推测优化失效时回退到解释执行或较低优化层。" },
    { "source_term": "on-stack replacement", "target_term": "栈上替换", "domain": "compilers", "definition": "在运行中把正在执行的循环切换到编译版本，即 OSR。" },
    { "source_term": "inline cache", "target_term": "内联缓存", "domain": "compilers", "definition": "缓存上次动态分派结果以加速后续调用。" },
    { "source_term": "hidden class", "target_term": "隐藏类", "domain": "compilers", "definition": "动态语言引擎为对象形状建立的结构描述。" },
    { "source_term": "profile-guided optimization", "target_term": "基于性能分析的优化", "domain": "compilers", "definition": "用实际运行剖面指导内联与布局，即 PGO。" },
    { "source_term": "link-time optimization", "target_term": "链接时优化", "domain": "compilers", "definition": "在链接阶段跨编译单元优化，即 LTO。" },
    { "source_term": "whole-program optimization", "target_term": "全程序优化", "domain": "compilers", "definition": "基于整个程序可见信息做优化。" },
    { "source_term": "separate compilation", "target_term": "分离编译", "domain": "compilers", "definition": "各源文件独立编译为目标文件再链接。" },
    { "source_term": "object file", "target_term": "目标文件", "domain": "compilers", "definition": "编译产生、尚未链接的机器码与符号文件。" },
    { "source_term": "relocation", "target_term": "重定位", "domain": "compilers", "definition": "链接或加载时修正符号地址的过程。" },
    { "source_term": "symbol resolution", "target_term": "符号解析", "domain": "compilers", "definition": "把未定义引用绑定到实际符号定义。" },
    { "source_term": "dynamic linking", "target_term": "动态链接", "domain": "compilers", "definition": "程序加载或运行时才解析共享库符号。" },
    { "source_term": "static linking", "target_term": "静态链接", "domain": "compilers", "definition": "把库代码直接复制进可执行文件。" },
    { "source_term": "program loader", "target_term": "程序加载器", "domain": "compilers", "definition": "把可执行文件映射到内存并启动执行的系统组件。" },
    { "source_term": "position-independent code", "target_term": "位置无关代码", "domain": "compilers", "definition": "可在任意地址加载执行的代码，即 PIC。" },
    { "source_term": "procedure linkage table", "target_term": "过程链接表", "domain": "compilers", "definition": "动态链接中用于延迟绑定外部函数的跳转表，即 PLT。" },
    { "source_term": "global offset table", "target_term": "全局偏移表", "domain": "compilers", "definition": "存放全局符号实际地址、供位置无关代码间接访问的表，即 GOT。" },
    { "source_term": "stack canary", "target_term": "栈金丝雀", "domain": "compilers", "definition": "栈上插入的哨兵值，用于检测缓冲区溢出。" },
    { "source_term": "undefined behavior", "target_term": "未定义行为", "domain": "compilers", "definition": "语言标准不规定结果、编译器可任意假设不发生的行为。" },
    { "source_term": "memory model", "target_term": "内存模型", "domain": "compilers", "definition": "规定多线程读写可见性与重排规则的语义模型。" },
    { "source_term": "happens-before relation", "target_term": "先行发生关系", "domain": "compilers", "definition": "保证前一个操作的效果对后一个操作可见的偏序关系。" },
    { "source_term": "data race", "target_term": "数据竞争", "domain": "compilers", "definition": "两个线程无同步地访问同一内存且至少一个为写。" },
    { "source_term": "atomic operation", "target_term": "原子操作", "domain": "compilers", "definition": "不可被观察到中间状态的操作。" },
    { "source_term": "lock-free", "target_term": "无锁", "domain": "compilers", "definition": "至少一个线程总能在有限步内推进的并发算法。" },
    { "source_term": "wait-free", "target_term": "无等待", "domain": "compilers", "definition": "每个线程都能在有限步内完成的更强并发保证。" },
    { "source_term": "acquire-release semantics", "target_term": "获取-释放语义", "domain": "compilers", "definition": "通过配对的内存序建立跨线程可见性。" },
    { "source_term": "memory barrier", "target_term": "内存屏障", "domain": "compilers", "definition": "限制编译器与处理器重排访存顺序的指令或约束。" },
    { "source_term": "covariant type parameter", "target_term": "协变类型参数", "domain": "compilers", "definition": "子类型关系与容器类型关系同向变化。" },
    { "source_term": "contravariant type parameter", "target_term": "逆变类型参数", "domain": "compilers", "definition": "子类型关系与容器类型关系反向变化。" },
    { "source_term": "type class", "target_term": "类型类", "domain": "compilers", "definition": "为一组类型声明共同接口、支持特设多态。" },
    { "source_term": "trait", "target_term": "特质", "domain": "compilers", "definition": "定义方法集合、可被类型实现的抽象接口。" },
    { "source_term": "mixin", "target_term": "混入", "domain": "compilers", "definition": "可被组合进类、提供可复用实现的模块。" },
