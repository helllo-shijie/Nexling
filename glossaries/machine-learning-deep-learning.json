    { "source_term": "causal language model", "target_term": "因果语言模型", "domain": "machine-learning", "definition": "只依据左侧上下文预测下一个词元。" },
    { "source_term": "few-shot learning", "target_term": "少样本学习", "domain": "machine-learning", "definition": "仅给少量示例即可完成新任务。" },
