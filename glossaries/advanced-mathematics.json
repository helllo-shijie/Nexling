    { "source_term": "manifold", "target_term": "流形", "domain": "mathematics", "definition": "局部同胚于欧氏空间的拓扑空间。" },
    { "source_term": "tangent space", "target_term": "切空间", "domain": "mathematics", "definition": "流形在某点处所有切向量构成的向量空间。" },
    { "source_term": "differential form", "target_term": "微分形式", "domain": "mathematics", "definition": "可在流形上积分的反对称张量场。" },
    { "source_term": "de Rham cohomology", "target_term": "德拉姆上同调", "domain": "mathematics", "definition": "用闭形式模恰当形式刻画流形拓扑的上同调。" },
    { "source_term": "homotopy", "target_term": "同伦", "domain": "mathematics", "definition": "两个映射可通过连续形变相互转化。" },
    { "source_term": "fundamental group", "target_term": "基本群", "domain": "mathematics", "definition": "以给定点为基点的闭路同伦类构成的群。" },
    { "source_term": "covering space", "target_term": "覆盖空间", "domain": "mathematics", "definition": "局部同胚地映射到基空间的拓扑空间。" },
    { "source_term": "group action", "target_term": "群作用", "domain": "mathematics", "definition": "群元素对集合元素施加、满足相容性的变换。" },
    { "source_term": "normal subgroup", "target_term": "正规子群", "domain": "mathematics", "definition": "对共轭封闭、可用来构造商群的子群。" },
    { "source_term": "quotient group", "target_term": "商群", "domain": "mathematics", "definition": "群对其正规子群的陪集构成的群。" },
    { "source_term": "group homomorphism", "target_term": "群同态", "domain": "mathematics", "definition": "保持群运算的映射。" },
    { "source_term": "isomorphism", "target_term": "同构", "domain": "mathematics", "definition": "存在双向保结构映射的两对象之间的关系。" },
    { "source_term": "monomorphism", "target_term": "单态射", "domain": "mathematics", "definition": "左可消的态射，在集合范畴中即单射；勿与编译器的单态化混淆。" },
    { "source_term": "epimorphism", "target_term": "满态射", "domain": "mathematics", "definition": "右可消的态射，在集合范畴中即满射。" },
    { "source_term": "cyclic group", "target_term": "循环群", "domain": "mathematics", "definition": "可由单个元素生成的群。" },
    { "source_term": "Sylow theorem", "target_term": "西罗定理", "domain": "mathematics", "definition": "关于有限群中最大 p 子群存在与数量的定理。" },
    { "source_term": "prime ideal", "target_term": "素理想", "domain": "mathematics", "definition": "商环为整环的理想，是代数几何中的点。" },
    { "source_term": "field extension", "target_term": "域扩张", "domain": "mathematics", "definition": "包含给定域作为子域的新域。" },
    { "source_term": "Galois group", "target_term": "伽罗瓦群", "domain": "mathematics", "definition": "域扩张中保持基域不动的自同构群。" },
    { "source_term": "free module", "target_term": "自由模", "domain": "mathematics", "definition": "具有基、每个元素可唯一线性表出的模。" },
    { "source_term": "tensor product", "target_term": "张量积", "domain": "mathematics", "definition": "把双线性映射泛化为线性映射的构造。" },
    { "source_term": "exact sequence", "target_term": "正合序列", "domain": "mathematics", "definition": "每个同态的像恰等于下一个同态的核。" },
    { "source_term": "functor", "target_term": "函子", "domain": "mathematics", "definition": "范畴之间保持对象与态射结构的映射。" },
    { "source_term": "natural transformation", "target_term": "自然变换", "domain": "mathematics", "definition": "两个函子之间满足自然性方块交换的态射族。" },
    { "source_term": "adjunction", "target_term": "伴随", "domain": "mathematics", "definition": "两个函子之间的一对自然同构 Hom 关系。" },
    { "source_term": "colimit", "target_term": "余极限", "domain": "mathematics", "definition": "图在范畴中的余锥泛对象，也称共限。" },
    { "source_term": "topological space", "target_term": "拓扑空间", "domain": "mathematics", "definition": "配有满足公理的开集族的集合。" },
    { "source_term": "open set", "target_term": "开集", "domain": "mathematics", "definition": "拓扑中每个点都有邻域包含于该集合的集合。" },
