{
  "schema_version": "glossary-package/v1",
  "pack_id": "databases-distributed-systems",
  "name": "数据库与分布式系统",
  "description": "关系模型、事务隔离、存储引擎与分布式一致性常用术语；英译中单向，共 149 条。",
  "version": "1.0.0",
  "langs": ["en", "zh-Hans"],
  "domain": "databases",
  "license": "CC-BY-4.0",
  "attribution": "NexLing community glossary",
  "entry_count": 149,
  "entries": [
    { "source_term": "relational model", "target_term": "关系模型", "domain": "databases", "definition": "以关系（表）与集合运算组织数据的模型。" },
    { "source_term": "tuple", "target_term": "元组", "domain": "databases", "definition": "关系表中的一行。" },
    { "source_term": "primary key", "target_term": "主键", "domain": "databases", "definition": "唯一标识表中每一行且不可为空的一列或列组。" },
    { "source_term": "foreign key", "target_term": "外键", "domain": "databases", "definition": "引用另一表主键、用于维护参照完整性的列。" },
    { "source_term": "candidate key", "target_term": "候选键", "domain": "databases", "definition": "能唯一标识元组的最小属性集。" },
    { "source_term": "superkey", "target_term": "超键", "domain": "databases", "definition": "能唯一标识元组的属性集，可含多余属性。" },
    { "source_term": "functional dependency", "target_term": "函数依赖", "domain": "databases", "definition": "一组属性唯一决定另一组属性的约束。" },
    { "source_term": "database normalization", "target_term": "数据库规范化", "domain": "databases", "definition": "通过分解消除冗余与更新异常的过程。" },
    { "source_term": "first normal form", "target_term": "第一范式", "domain": "databases", "definition": "属性不可再分、不含重复组的表结构。" },
    { "source_term": "second normal form", "target_term": "第二范式", "domain": "databases", "definition": "满足第一范式且非主属性完全依赖于候选键。" },
    { "source_term": "third normal form", "target_term": "第三范式", "domain": "databases", "definition": "满足第二范式且非主属性不传递依赖于候选键。" },
    { "source_term": "Boyce-Codd normal form", "target_term": "BCNF", "domain": "databases", "definition": "每个非平凡函数依赖的决定因素都是超键。" },
    { "source_term": "denormalization", "target_term": "反规范化", "domain": "databases", "definition": "有意引入冗余以减少连接、提升读性能。" },
    { "source_term": "inner join", "target_term": "内连接", "domain": "databases", "definition": "只保留两表连接条件匹配的行。" },
    { "source_term": "left outer join", "target_term": "左外连接", "domain": "databases", "definition": "保留左表全部行，右表无匹配时补空值。" },
    { "source_term": "right outer join", "target_term": "右外连接", "domain": "databases", "definition": "保留右表全部行，左表无匹配时补空值。" },
    { "source_term": "full outer join", "target_term": "全外连接", "domain": "databases", "definition": "保留两表全部行，缺失一侧补空值。" },
    { "source_term": "semi-join", "target_term": "半连接", "domain": "databases", "definition": "只返回左表中在右表存在匹配的行，不复制右表列。" },
    { "source_term": "anti-join", "target_term": "反连接", "domain": "databases", "definition": "只返回在另一表中不存在匹配的行。" },
    { "source_term": "cross join", "target_term": "交叉连接", "domain": "databases", "definition": "两表行的笛卡尔积。" },
    { "source_term": "query plan", "target_term": "查询计划", "domain": "databases", "definition": "优化器选定的算子顺序与访问路径。" },
    { "source_term": "query optimizer", "target_term": "查询优化器", "domain": "databases", "definition": "在等价计划中选择代价最低者的组件。" },
    { "source_term": "optimizer cost model", "target_term": "优化器代价模型", "domain": "databases", "definition": "估算各计划 I/O 与 CPU 代价的公式。" },
    { "source_term": "cardinality estimation", "target_term": "基数估计", "domain": "databases", "definition": "估算中间结果行数，是计划选择的关键。" },
    { "source_term": "index scan", "target_term": "索引扫描", "domain": "databases", "definition": "沿索引有序访问满足条件的行。" },
    { "source_term": "sequential scan", "target_term": "顺序扫描", "domain": "databases", "definition": "从头到尾读取整张表，又称全表扫描。" },
    { "source_term": "bitmap index", "target_term": "位图索引", "domain": "databases", "definition": "用位图表示每个取值对应行集合的索引。" },
    { "source_term": "B+ tree", "target_term": "B+ 树", "domain": "databases", "definition": "所有数据在叶节点、叶节点链表相连的多路平衡树。" },
    { "source_term": "hash index", "target_term": "哈希索引", "domain": "databases", "definition": "按键哈希值定位、仅支持等值查询的索引。" },
    { "source_term": "covering index", "target_term": "覆盖索引", "domain": "databases", "definition": "包含查询所需全部列的索引，可免回表。" },
    { "source_term": "composite index", "target_term": "复合索引", "domain": "databases", "definition": "由多列按顺序组成的索引，遵循最左前缀。" },
    { "source_term": "clustered index", "target_term": "聚簇索引", "domain": "databases", "definition": "决定表中数据物理存储顺序的索引。" },
    { "source_term": "secondary index", "target_term": "二级索引", "domain": "databases", "definition": "不决定数据物理顺序、需回表取其余列的索引。" },
    { "source_term": "write-ahead logging", "target_term": "预写式日志", "domain": "databases", "definition": "先写日志再改数据页以保证崩溃恢复，即 WAL。" },
    { "source_term": "redo log", "target_term": "重做日志", "domain": "databases", "definition": "记录已提交修改，用于崩溃后重放。" },
    { "source_term": "undo log", "target_term": "回滚日志", "domain": "databases", "definition": "记录修改前值，用于回滚与多版本读取。" },
    { "source_term": "checkpoint", "target_term": "检查点", "domain": "databases", "definition": "把内存脏页刷盘并记录恢复起点的动作。" },
    { "source_term": "buffer pool", "target_term": "缓冲池", "domain": "databases", "definition": "缓存磁盘页的内存区域。" },
    { "source_term": "page replacement", "target_term": "页面置换", "domain": "databases", "definition": "缓冲池满时选择淘汰哪一页的策略。" },
    { "source_term": "shadow paging", "target_term": "影子分页", "domain": "databases", "definition": "写时复制页面、原子切换根指针的恢复技术。" },
    { "source_term": "multi-version concurrency control", "target_term": "多版本并发控制", "domain": "databases", "definition": "保留数据多版本使读写互不阻塞，即 MVCC。" },
    { "source_term": "snapshot isolation", "target_term": "快照隔离", "domain": "databases", "definition": "事务读取开始时的一致性快照。" },
    { "source_term": "serializable isolation", "target_term": "可串行化隔离", "domain": "databases", "definition": "并发结果等价于某个串行执行顺序的最强隔离级别。" },
    { "source_term": "read committed", "target_term": "读已提交", "domain": "databases", "definition": "只能读到已提交数据，可能不可重复读。" },
    { "source_term": "repeatable read", "target_term": "可重复读", "domain": "databases", "definition": "同一事务内多次读取同一行结果一致。" },
    { "source_term": "phantom read", "target_term": "幻读", "domain": "databases", "definition": "同一事务内两次范围查询看到新增行。" },
    { "source_term": "dirty read", "target_term": "脏读", "domain": "databases", "definition": "读到了其他事务尚未提交的修改。" },
    { "source_term": "lost update", "target_term": "丢失更新", "domain": "databases", "definition": "并发写互相覆盖，导致某次更新丢失。" },
    { "source_term": "write skew", "target_term": "写偏斜", "domain": "databases", "definition": "两个事务各读不同行、写不同行却共同破坏约束。" },
    { "source_term": "two-phase locking", "target_term": "两阶段锁", "domain": "databases", "definition": "加锁阶段与解锁阶段严格分开的并发控制协议。" },
    { "source_term": "deadlock detection", "target_term": "死锁检测", "domain": "databases", "definition": "通过等待图发现环路并回滚牺牲事务。" },
    { "source_term": "lock escalation", "target_term": "锁升级", "domain": "databases", "definition": "行锁过多时升级为页锁或表锁以减少开销。" },
    { "source_term": "optimistic concurrency control", "target_term": "乐观并发控制", "domain": "databases", "definition": "提交时校验版本冲突，冲突则重试。" },
    { "source_term": "pessimistic concurrency control", "target_term": "悲观并发控制", "domain": "databases", "definition": "访问前先加锁，假定冲突频繁。" },
    { "source_term": "transaction", "target_term": "事务", "domain": "databases", "definition": "一组要么全部生效、要么全部回滚的操作。" },
    { "source_term": "atomicity", "target_term": "原子性", "domain": "databases", "definition": "事务内操作不可分割，要么全做要么全不做。" },
    { "source_term": "data consistency", "target_term": "数据一致性", "domain": "databases", "definition": "事务前后数据满足全部完整性约束。" },
    { "source_term": "transaction isolation", "target_term": "事务隔离", "domain": "databases", "definition": "并发事务之间互不干扰的程度。" },
    { "source_term": "durability", "target_term": "持久性", "domain": "databases", "definition": "提交后的修改即使崩溃也不会丢失。" },
    { "source_term": "CAP theorem", "target_term": "CAP 定理", "domain": "databases", "definition": "分区发生时一致性与可用性不可兼得。" },
    { "source_term": "PACELC theorem", "target_term": "PACELC 定理", "domain": "databases", "definition": "分区时权衡 A/C，正常时权衡延迟与一致性。" },
    { "source_term": "eventual consistency", "target_term": "最终一致性", "domain": "databases", "definition": "停止写入后副本最终收敛到同一值。" },
    { "source_term": "strong consistency", "target_term": "强一致性", "domain": "databases", "definition": "读操作总能返回最近一次写入的结果。" },
    { "source_term": "linearizability", "target_term": "线性一致性", "domain": "databases", "definition": "并发操作可视为按实时顺序原子执行。" },
    { "source_term": "sequential consistency", "target_term": "顺序一致性", "domain": "databases", "definition": "所有进程看到同一全局顺序，且各自程序顺序保持。" },
    { "source_term": "causal consistency", "target_term": "因果一致性", "domain": "databases", "definition": "有因果关系的操作对所有节点按同一顺序可见。" },
    { "source_term": "vector clock", "target_term": "向量时钟", "domain": "databases", "definition": "用各节点计数器判断事件并发或因果先后。" },
    { "source_term": "Lamport timestamp", "target_term": "兰波特时间戳", "domain": "databases", "definition": "提供全序但只能判断因果的必要条件。" },
    { "source_term": "logical clock", "target_term": "逻辑时钟", "domain": "databases", "definition": "不依赖物理时间、用于排序事件的计数器。" },
    { "source_term": "two-phase commit", "target_term": "两阶段提交", "domain": "databases", "definition": "协调者先询问准备、再统一提交或回滚。" },
    { "source_term": "three-phase commit", "target_term": "三阶段提交", "domain": "databases", "definition": "在预提交与提交之间增加阶段以降低阻塞。" },
    { "source_term": "saga pattern", "target_term": "Saga 模式", "domain": "databases", "definition": "用一系列本地事务与补偿动作实现长事务。" },
    { "source_term": "distributed transaction", "target_term": "分布式事务", "domain": "databases", "definition": "跨多个节点或数据库的事务。" },
    { "source_term": "idempotency", "target_term": "幂等性", "domain": "databases", "definition": "同一操作执行多次与执行一次效果相同。" },
    { "source_term": "at-least-once delivery", "target_term": "至少一次投递", "domain": "databases", "definition": "消息保证送达但可能重复。" },
    { "source_term": "exactly-once semantics", "target_term": "精确一次语义", "domain": "databases", "definition": "消息不丢不重地恰好处理一次。" },
    { "source_term": "message queue", "target_term": "消息队列", "domain": "databases", "definition": "异步解耦生产者和消费者的中间件。" },
    { "source_term": "publish-subscribe", "target_term": "发布-订阅", "domain": "databases", "definition": "发布者按主题广播、订阅者按兴趣接收。" },
    { "source_term": "backpressure", "target_term": "背压", "domain": "databases", "definition": "下游处理不及时间上游施加的反向压力。" },
    { "source_term": "sharding", "target_term": "分片", "domain": "databases", "definition": "按规则把数据水平拆分到多个节点。" },
    { "source_term": "partition key", "target_term": "分区键", "domain": "databases", "definition": "决定数据落到哪个分片的键。" },
    { "source_term": "consistent hashing", "target_term": "一致性哈希", "domain": "databases", "definition": "节点增减时仅少量键需重新映射的哈希方案。" },
    { "source_term": "virtual node", "target_term": "虚拟节点", "domain": "databases", "definition": "一致性哈希中把物理节点拆成多个逻辑位置以均衡负载。" },
    { "source_term": "rebalancing", "target_term": "再均衡", "domain": "databases", "definition": "节点变化后迁移数据以恢复负载均衡。" },
    { "source_term": "data hotspot", "target_term": "数据热点", "domain": "databases", "definition": "某分片或键访问量远超其他，造成倾斜。" },
    { "source_term": "read replica", "target_term": "只读副本", "domain": "databases", "definition": "异步复制主库数据、承担读流量的实例。" },
    { "source_term": "failover", "target_term": "故障转移", "domain": "databases", "definition": "主节点失效时切换到备用节点。" },
    { "source_term": "leaderless replication", "target_term": "无主复制", "domain": "databases", "definition": "客户端直接写多个副本，不使用单一主节点。" },
    { "source_term": "hinted handoff", "target_term": "提示移交", "domain": "databases", "definition": "副本暂不可用时由其他节点代存写操作。" },
    { "source_term": "read repair", "target_term": "读修复", "domain": "databases", "definition": "读取时发现副本不一致并回写最新值。" },
    { "source_term": "anti-entropy", "target_term": "反熵", "domain": "databases", "definition": "后台比较并同步副本差异的过程。" },
    { "source_term": "Merkle tree", "target_term": "默克尔树", "domain": "databases", "definition": "用哈希树高效比较大数据集差异。" },
    { "source_term": "gossip protocol", "target_term": "流言协议", "domain": "databases", "definition": "节点随机交换状态、最终传播到全网的协议。" },
    { "source_term": "membership protocol", "target_term": "成员协议", "domain": "databases", "definition": "维护集群中存活节点视图的协议。" },
    { "source_term": "distributed lock", "target_term": "分布式锁", "domain": "databases", "definition": "跨节点互斥访问共享资源的机制。" },
    { "source_term": "fencing token", "target_term": "栅栏令牌", "domain": "databases", "definition": "单调递增的令牌，用于阻止过期持有者继续写入。" },
    { "source_term": "service discovery", "target_term": "服务发现", "domain": "databases", "definition": "动态获知服务实例地址的机制。" },
    { "source_term": "circuit breaker", "target_term": "熔断器", "domain": "databases", "definition": "下游连续失败时快速失败、防止雪崩。" },
    { "source_term": "bulkhead pattern", "target_term": "舱壁模式", "domain": "databases", "definition": "隔离资源池，避免单点故障耗尽全部资源。" },
    { "source_term": "retry storm", "target_term": "重试风暴", "domain": "databases", "definition": "大量客户端同时重试，进一步压垮故障服务。" },
    { "source_term": "tail latency", "target_term": "尾延迟", "domain": "databases", "definition": "高分位（如 P99）请求的延迟。" },
    { "source_term": "service level agreement", "target_term": "服务等级协议", "domain": "databases", "definition": "服务方与客户约定的可用性与性能承诺，即 SLA。" },
    { "source_term": "service level objective", "target_term": "服务等级目标", "domain": "databases", "definition": "团队内部量化的可靠性目标，即 SLO。" },
    { "source_term": "observability", "target_term": "可观测性", "domain": "databases", "definition": "通过日志、指标与追踪推断系统内部状态的能力。" },
    { "source_term": "distributed tracing", "target_term": "分布式追踪", "domain": "databases", "definition": "跨服务记录请求调用链与耗时。" },
    { "source_term": "columnar storage", "target_term": "列式存储", "domain": "databases", "definition": "按列连续存储，利于分析查询与压缩。" },
    { "source_term": "row-oriented storage", "target_term": "行式存储", "domain": "databases", "definition": "按行连续存储，利于点查与事务写入。" },
    { "source_term": "log-structured merge tree", "target_term": "日志结构合并树", "domain": "databases", "definition": "把写入追加为有序文件并后台合并的存储结构，即 LSM 树。" },
    { "source_term": "memtable", "target_term": "内存表", "domain": "databases", "definition": "LSM 树中先在内存有序缓存写入的结构。" },
    { "source_term": "sorted string table", "target_term": "有序字符串表", "domain": "databases", "definition": "LSM 树落盘的有序不可变文件，即 SSTable。" },
    { "source_term": "compaction", "target_term": "压实", "domain": "databases", "definition": "合并多个有序文件、清除过期版本以回收空间。" },
    { "source_term": "tombstone", "target_term": "墓碑标记", "domain": "databases", "definition": "表示删除的占位记录，待压实后真正清除。" },
    { "source_term": "bloom filter", "target_term": "布隆过滤器", "domain": "databases", "definition": "以少量内存判断元素“可能存在或一定不存在”。" },
    { "source_term": "write amplification", "target_term": "写放大", "domain": "databases", "definition": "实际写入量相对逻辑写入量的倍数。" },
    { "source_term": "read amplification", "target_term": "读放大", "domain": "databases", "definition": "一次逻辑读实际读取的文件或页数。" },
    { "source_term": "space amplification", "target_term": "空间放大", "domain": "databases", "definition": "实际占用空间相对逻辑数据量的倍数。" },
    { "source_term": "data warehouse", "target_term": "数据仓库", "domain": "databases", "definition": "面向分析、集成多源历史数据的存储系统。" },
    { "source_term": "data lake", "target_term": "数据湖", "domain": "databases", "definition": "以原始格式集中存储海量数据的平台。" },
    { "source_term": "online transaction processing", "target_term": "联机事务处理", "domain": "databases", "definition": "面向高并发短事务的业务负载，即 OLTP。" },
    { "source_term": "online analytical processing", "target_term": "联机分析处理", "domain": "databases", "definition": "面向大规模聚合分析的负载，即 OLAP。" },
    { "source_term": "extract-transform-load", "target_term": "抽取-转换-加载", "domain": "databases", "definition": "把源数据抽取、清洗转换后装入目标库，即 ETL。" },
    { "source_term": "stream processing", "target_term": "流处理", "domain": "databases", "definition": "对无界数据流持续计算。" },
    { "source_term": "windowing", "target_term": "窗口化", "domain": "databases", "definition": "把无界流切分为有限窗口进行聚合。" },
    { "source_term": "event-time watermark", "target_term": "事件时间水位线", "domain": "databases", "definition": "表示早于该时刻的事件已基本到齐，用于触发窗口计算。" },
    { "source_term": "change data capture", "target_term": "变更数据捕获", "domain": "databases", "definition": "捕获数据库增量变更并下游同步，即 CDC。" },
