  "entries": [
    { "source_term": "backpropagation", "target_term": "反向传播", "domain": "machine-learning", "definition": "按链式法则从输出层向前逐层计算梯度的算法。" },
    { "source_term": "gradient descent", "target_term": "梯度下降", "domain": "machine-learning", "definition": "沿负梯度方向更新参数以最小化损失。" },
    { "source_term": "stochastic gradient descent", "target_term": "随机梯度下降", "domain": "machine-learning", "definition": "每次用单个或少量样本估计梯度并更新参数。" },
    { "source_term": "mini-batch", "target_term": "小批量", "domain": "machine-learning", "definition": "一次前向与反向传播所使用的样本子集。" },
    { "source_term": "learning rate", "target_term": "学习率", "domain": "machine-learning", "definition": "每次参数更新所乘的步长。" },
    { "source_term": "learning rate schedule", "target_term": "学习率调度", "domain": "machine-learning", "definition": "训练过程中按策略调整学习率，如余弦退火。" },
    { "source_term": "weight decay", "target_term": "权重衰减", "domain": "machine-learning", "definition": "在损失中加入参数范数惩罚以抑制过拟合。" },
    { "source_term": "momentum", "target_term": "动量", "domain": "machine-learning", "definition": "累积历史梯度方向以加速收敛并抑制震荡；指优化器动量。" },
    { "source_term": "Adam optimizer", "target_term": "Adam 优化器", "domain": "machine-learning", "definition": "结合动量与自适应学习率的优化算法。" },
    { "source_term": "batch normalization", "target_term": "批归一化", "domain": "machine-learning", "definition": "按小批量统计量归一化中间激活，稳定训练。" },
    { "source_term": "layer normalization", "target_term": "层归一化", "domain": "machine-learning", "definition": "按单个样本的特征维度归一化，常用于序列模型。" },
