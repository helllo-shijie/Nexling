{
  "name": "nexling-webui",
  "version": "1.11.0",
  "private": true,
  "type": "module",
  "description": "NexLing 技术翻译工作台前端（React 18 + TypeScript + Vite + Zustand）",
  "scripts": {
    "dev": "vite",
