    { "source_term": "overfitting", "target_term": "过拟合", "domain": "machine-learning", "definition": "模型记住训练集噪声、泛化性能下降。" },
    { "source_term": "underfitting", "target_term": "欠拟合", "domain": "machine-learning", "definition": "模型容量不足，训练集与测试集表现都差。" },
    { "source_term": "regularization", "target_term": "正则化", "domain": "machine-learning", "definition": "通过约束模型复杂度提升泛化的手段。" },
    { "source_term": "L1 regularization", "target_term": "L1 正则化", "domain": "machine-learning", "definition": "加入参数绝对值之和的惩罚，倾向产生稀疏解。" },
    { "source_term": "L2 regularization", "target_term": "L2 正则化", "domain": "machine-learning", "definition": "加入参数平方和的惩罚，使权重趋于平滑。" },
    { "source_term": "cross-entropy loss", "target_term": "交叉熵损失", "domain": "machine-learning", "definition": "衡量预测分布与真实分布差异的分类损失。" },
    { "source_term": "mean squared error", "target_term": "均方误差", "domain": "machine-learning", "definition": "预测值与真实值差平方的平均，常用于回归。" },
    { "source_term": "softmax function", "target_term": "Softmax 函数", "domain": "machine-learning", "definition": "把实数向量转换为和为 1 的概率分布。" },
    { "source_term": "sigmoid function", "target_term": "Sigmoid 函数", "domain": "machine-learning", "definition": "把实数压缩到 (0,1) 的 S 形函数。" },
    { "source_term": "rectified linear unit", "target_term": "修正线性单元", "domain": "machine-learning", "definition": "ReLU，即 max(0,x)。" },
    { "source_term": "activation function", "target_term": "激活函数", "domain": "machine-learning", "definition": "为网络引入非线性的逐元素函数。" },
    { "source_term": "vanishing gradient", "target_term": "梯度消失", "domain": "machine-learning", "definition": "深层网络反向传播时梯度逐层衰减到接近零。" },
    { "source_term": "exploding gradient", "target_term": "梯度爆炸", "domain": "machine-learning", "definition": "反向传播梯度逐层放大导致训练发散。" },
    { "source_term": "residual connection", "target_term": "残差连接", "domain": "machine-learning", "definition": "把输入直接加到子层输出，缓解深层退化。" },
    { "source_term": "skip connection", "target_term": "跳跃连接", "domain": "machine-learning", "definition": "跨层直连的旁路，使梯度与信息更易流动。" },
    { "source_term": "attention mechanism", "target_term": "注意力机制", "domain": "machine-learning", "definition": "按相关性对输入各部分加权汇总的机制。" },
    { "source_term": "self-attention", "target_term": "自注意力", "domain": "machine-learning", "definition": "序列内部各位置相互计算注意力权重。" },
    { "source_term": "multi-head attention", "target_term": "多头注意力", "domain": "machine-learning", "definition": "并行多组注意力拼接，捕捉不同子空间关系。" },
    { "source_term": "transformer architecture", "target_term": "Transformer 架构", "domain": "machine-learning", "definition": "以自注意力与前馈层堆叠、可并行处理序列的架构。" },
    { "source_term": "positional encoding", "target_term": "位置编码", "domain": "machine-learning", "definition": "向词向量注入位置信息，弥补注意力无顺序感。" },
    { "source_term": "word embedding", "target_term": "词嵌入", "domain": "machine-learning", "definition": "把词映射为稠密向量的表示。" },
