{
  "schema_version": "glossary-package/v1",
  "pack_id": "digital-hardware-semiconductors",
  "name": "数字硬件与半导体",
  "description": "数字电路、处理器微架构、存储器与半导体制造常用术语；英译中单向，共 127 条。",
  "version": "1.0.0",
  "langs": ["en", "zh-Hans"],
  "domain": "hardware",
  "license": "CC-BY-4.0",
  "attribution": "NexLing community glossary",
  "entry_count": 127,
  "entries": [
    { "source_term": "cache coherence", "target_term": "缓存一致性", "domain": "hardware", "definition": "多核共享内存时保证各私有缓存不读到过期数据；勿译作“缓存连贯”。" },
    { "source_term": "cache line", "target_term": "缓存行", "domain": "hardware", "definition": "缓存与主存之间搬运数据的最小单位，通常 64 字节。" },
    { "source_term": "memory hierarchy", "target_term": "存储层次结构", "domain": "hardware", "definition": "寄存器、缓存、主存、外存的层级组织；勿译作“内存等级”。" },
    { "source_term": "out-of-order execution", "target_term": "乱序执行", "domain": "hardware", "definition": "指令按操作数就绪顺序执行、按程序顺序提交。" },
    { "source_term": "in-order execution", "target_term": "顺序执行", "domain": "hardware", "definition": "严格按程序顺序发射与执行的流水线方式。" },
    { "source_term": "speculative execution", "target_term": "推测执行", "domain": "hardware", "definition": "分支结果未定时提前执行，提交前可回滚；部分文献也作“投机执行”。" },
    { "source_term": "branch predictor", "target_term": "分支预测器", "domain": "hardware", "definition": "预测条件分支走向以减少流水线停顿的硬件部件。" },
    { "source_term": "branch misprediction", "target_term": "分支预测失败", "domain": "hardware", "definition": "预测方向错误，需要冲刷流水线并重新取指。" },
    { "source_term": "pipeline stall", "target_term": "流水线停顿", "domain": "hardware", "definition": "因依赖或资源冲突插入气泡，流水线暂停若干周期。" },
    { "source_term": "pipeline hazard", "target_term": "流水线冒险", "domain": "hardware", "definition": "结构、数据或控制冲突导致下一条指令无法按周期推进。" },
    { "source_term": "data hazard", "target_term": "数据冒险", "domain": "hardware", "definition": "后续指令依赖前序指令尚未写回的结果。" },
    { "source_term": "control hazard", "target_term": "控制冒险", "domain": "hardware", "definition": "分支或跳转改变取指地址造成的流水线不确定性。" },
    { "source_term": "instruction-level parallelism", "target_term": "指令级并行", "domain": "hardware", "definition": "同一时刻并行执行多条无依赖指令的能力。" },
    { "source_term": "register renaming", "target_term": "寄存器重命名", "domain": "hardware", "definition": "用物理寄存器消除假数据依赖，支持乱序执行。" },
    { "source_term": "superscalar", "target_term": "超标量", "domain": "hardware", "definition": "单周期发射多条指令的处理器结构。" },
    { "source_term": "very long instruction word", "target_term": "超长指令字", "domain": "hardware", "definition": "由编译器把多条操作打包进一条长指令的架构。" },
    { "source_term": "systolic array", "target_term": "脉动阵列", "domain": "hardware", "definition": "数据按节拍在相邻处理单元间流动的规则阵列，常用于矩阵加速。" },
    { "source_term": "clock skew", "target_term": "时钟偏斜", "domain": "hardware", "definition": "同一时钟到达不同寄存器的时刻差异；勿与抖动混为一谈。" },
    { "source_term": "clock jitter", "target_term": "时钟抖动", "domain": "hardware", "definition": "时钟周期随时间的随机波动，与固定的偏斜不同。" },
    { "source_term": "setup time", "target_term": "建立时间", "domain": "hardware", "definition": "时钟沿到来前数据必须保持稳定的最短时间。" },
    { "source_term": "hold time", "target_term": "保持时间", "domain": "hardware", "definition": "时钟沿到来后数据仍需保持稳定的最短时间。" },
    { "source_term": "metastability", "target_term": "亚稳态", "domain": "hardware", "definition": "触发器采样到临界电平时输出长时间不确定的状态。" },
    { "source_term": "clock domain crossing", "target_term": "跨时钟域", "domain": "hardware", "definition": "信号在两个异步时钟域之间传递，需要同步器处理。" },
    { "source_term": "flip-flop", "target_term": "触发器", "domain": "hardware", "definition": "边沿触发的存储单元；勿与电平敏感的锁存器混淆。" },
    { "source_term": "latch", "target_term": "锁存器", "domain": "hardware", "definition": "电平敏感、在使能期间透明的存储单元。" },
    { "source_term": "combinational logic", "target_term": "组合逻辑", "domain": "hardware", "definition": "输出仅由当前输入决定、不含记忆元件的逻辑。" },
    { "source_term": "sequential logic", "target_term": "时序逻辑", "domain": "hardware", "definition": "输出还取决于历史状态的逻辑，通常含触发器。" },
    { "source_term": "finite state machine", "target_term": "有限状态机", "domain": "hardware", "definition": "由有限状态、转移条件和输出函数构成的控制器模型。" },
    { "source_term": "timing closure", "target_term": "时序收敛", "domain": "hardware", "definition": "设计满足全部建立与保持时间约束的状态。" },
    { "source_term": "static timing analysis", "target_term": "静态时序分析", "domain": "hardware", "definition": "不依赖激励向量、穷举路径计算时序裕量的方法。" },
    { "source_term": "critical path", "target_term": "关键路径", "domain": "hardware", "definition": "决定电路最高工作频率的最长延时路径。" },
    { "source_term": "fan-out", "target_term": "扇出", "domain": "hardware", "definition": "一个输出驱动的下级输入数量。" },
    { "source_term": "fan-in", "target_term": "扇入", "domain": "hardware", "definition": "一个逻辑门可接受的输入数量。" },
    { "source_term": "glitch", "target_term": "毛刺", "domain": "hardware", "definition": "组合逻辑因路径延时差异产生的窄脉冲。" },
    { "source_term": "race hazard", "target_term": "竞争冒险", "domain": "hardware", "definition": "信号到达先后不同导致输出出现非预期跳变。" },
    { "source_term": "tri-state buffer", "target_term": "三态缓冲器", "domain": "hardware", "definition": "输出可处于高、低、高阻三种状态的驱动电路。" },
    { "source_term": "multiplexer", "target_term": "多路选择器", "domain": "hardware", "definition": "按选择信号从多路输入中选出一路输出。" },
    { "source_term": "demultiplexer", "target_term": "解复用器", "domain": "hardware", "definition": "把一路输入分配到多路输出中的一路。" },
    { "source_term": "decoder", "target_term": "译码器", "domain": "hardware", "definition": "把二进制编码转换为独热或多路选中信号；勿与解码器混淆。" },
    { "source_term": "encoder", "target_term": "编码器", "domain": "hardware", "definition": "把多路有效信号压缩为二进制编码。" },
    { "source_term": "shift register", "target_term": "移位寄存器", "domain": "hardware", "definition": "每个时钟沿把数据逐位移动的寄存器链。" },
    { "source_term": "ripple carry adder", "target_term": "行波进位加法器", "domain": "hardware", "definition": "进位逐级传播的加法器，延时随位宽线性增长。" },
    { "source_term": "carry lookahead adder", "target_term": "超前进位加法器", "domain": "hardware", "definition": "并行计算进位以缩短关键路径的加法器。" },
    { "source_term": "barrel shifter", "target_term": "桶形移位器", "domain": "hardware", "definition": "单周期完成任意位数移位的多级选择网络。" },
    { "source_term": "arithmetic logic unit", "target_term": "算术逻辑单元", "domain": "hardware", "definition": "执行加减、逻辑与移位等运算的处理器部件。" },
    { "source_term": "static random access memory", "target_term": "静态随机存取存储器", "domain": "hardware", "definition": "用双稳态触发器存位、无需刷新的存储器。" },
    { "source_term": "dynamic random access memory", "target_term": "动态随机存取存储器", "domain": "hardware", "definition": "用电容存位、需要周期性刷新的存储器。" },
    { "source_term": "sense amplifier", "target_term": "灵敏放大器", "domain": "hardware", "definition": "把位线上的微小电压差放大为逻辑电平的电路。" },
    { "source_term": "word line", "target_term": "字线", "domain": "hardware", "definition": "存储阵列中选中一整行单元的横向控制线。" },
    { "source_term": "bit line", "target_term": "位线", "domain": "hardware", "definition": "存储阵列中传递单元数据的纵向信号线。" },
    { "source_term": "row buffer", "target_term": "行缓冲", "domain": "hardware", "definition": "DRAM 中缓存已打开行的数据，命中可减少访问延时。" },
    { "source_term": "DRAM refresh", "target_term": "DRAM 刷新", "domain": "hardware", "definition": "周期性重写电容电荷以防数据丢失。" },
    { "source_term": "wear leveling", "target_term": "磨损均衡", "domain": "hardware", "definition": "把擦写均匀分散到各闪存块以延长寿命。" },
    { "source_term": "error-correcting code", "target_term": "纠错码", "domain": "hardware", "definition": "通过冗余校验位检测并纠正存储或传输错误。" },
    { "source_term": "Hamming code", "target_term": "汉明码", "domain": "hardware", "definition": "可纠正单比特错误并检测双比特错误的线性纠错码。" },
    { "source_term": "threshold voltage", "target_term": "阈值电压", "domain": "hardware", "definition": "使晶体管沟道开始导通的栅源电压。" },
    { "source_term": "subthreshold leakage", "target_term": "亚阈值漏电", "domain": "hardware", "definition": "栅压低于阈值时沟道仍存在的漏电流。" },
    { "source_term": "short-channel effect", "target_term": "短沟道效应", "domain": "hardware", "definition": "沟道缩短后阈值下降、漏电增大等非理想现象。" },
    { "source_term": "FinFET", "target_term": "鳍式场效应晶体管", "domain": "hardware", "definition": "栅极三面包裹鳍状沟道的立体晶体管结构。" },
    { "source_term": "gate-all-around transistor", "target_term": "全环绕栅极晶体管", "domain": "hardware", "definition": "栅极四面包裹沟道，控制力强于 FinFET。" },
    { "source_term": "complementary metal-oxide-semiconductor", "target_term": "互补金属氧化物半导体", "domain": "hardware", "definition": "NMOS 与 PMOS 互补连接的主流数字电路工艺。" },
    { "source_term": "doping", "target_term": "掺杂", "domain": "hardware", "definition": "向半导体引入杂质以调控导电类型与浓度。" },
    { "source_term": "lithography", "target_term": "光刻", "domain": "hardware", "definition": "用光照把掩模图形转移到光刻胶上的工艺。" },
    { "source_term": "photoresist", "target_term": "光刻胶", "domain": "hardware", "definition": "曝光后溶解性改变、用于图形转移的感光材料。" },
    { "source_term": "photomask", "target_term": "光罩", "domain": "hardware", "definition": "承载电路图形、用于光刻曝光的原版，也称光掩模。" },
    { "source_term": "wafer", "target_term": "晶圆", "domain": "hardware", "definition": "用于批量制造芯片的圆形半导体衬底。" },
    { "source_term": "semiconductor die", "target_term": "半导体裸片", "domain": "hardware", "definition": "从晶圆切割出的单个未封装芯片。" },
    { "source_term": "tape-out", "target_term": "流片", "domain": "hardware", "definition": "设计定稿并交付晶圆厂投产的首批制造。" },
    { "source_term": "foundry", "target_term": "晶圆代工厂", "domain": "hardware", "definition": "只代工制造、不自行设计芯片的厂商。" },
    { "source_term": "fabless", "target_term": "无晶圆厂", "domain": "hardware", "definition": "只做芯片设计、把制造外包的商业模式。" },
    { "source_term": "process node", "target_term": "制程节点", "domain": "hardware", "definition": "标志工艺代际的特征尺寸命名，如 7nm、3nm。" },
    { "source_term": "wafer yield", "target_term": "晶圆良率", "domain": "hardware", "definition": "每片晶圆上合格芯片所占比例。" },
    { "source_term": "design rule check", "target_term": "设计规则检查", "domain": "hardware", "definition": "检查版图是否满足晶圆厂最小尺寸与间距规则。" },
    { "source_term": "layout versus schematic", "target_term": "版图与原理图一致性检查", "domain": "hardware", "definition": "比对版图提取网表与原始原理图是否一致。" },
    { "source_term": "standard cell", "target_term": "标准单元", "domain": "hardware", "definition": "预先设计好、可被自动布局布线复用的逻辑单元。" },
    { "source_term": "place and route", "target_term": "布局布线", "domain": "hardware", "definition": "把网表单元摆放并按规则连线，形成物理版图。" },
    { "source_term": "floorplan", "target_term": "布图规划", "domain": "hardware", "definition": "确定芯片模块位置、形状与引脚分配的早期步骤。" },
    { "source_term": "clock tree synthesis", "target_term": "时钟树综合", "domain": "hardware", "definition": "构建低偏斜时钟分布网络的过程。" },
    { "source_term": "power gating", "target_term": "电源门控", "domain": "hardware", "definition": "切断闲置模块电源以降低静态功耗。" },
    { "source_term": "dynamic voltage and frequency scaling", "target_term": "动态电压频率调节", "domain": "hardware", "definition": "按负载实时调整电压与频率以省电。" },
    { "source_term": "level shifter", "target_term": "电平转换器", "domain": "hardware", "definition": "在不同电源电压域之间转换信号电平。" },
    { "source_term": "isolation cell", "target_term": "隔离单元", "domain": "hardware", "definition": "电源关断时把输出钳位，防止不确定信号传播。" },
    { "source_term": "scan chain", "target_term": "扫描链", "domain": "hardware", "definition": "把触发器串成移位链以支持可测性设计。" },
    { "source_term": "built-in self-test", "target_term": "内建自测试", "domain": "hardware", "definition": "芯片内部自行生成激励并判定测试结果的机制。" },
    { "source_term": "automatic test pattern generation", "target_term": "自动测试向量生成", "domain": "hardware", "definition": "由工具自动生成覆盖目标故障的测试激励。" },
    { "source_term": "fault coverage", "target_term": "故障覆盖率", "domain": "hardware", "definition": "测试向量能检测到的目标故障比例。" },
    { "source_term": "soft error", "target_term": "软错误", "domain": "hardware", "definition": "辐射等瞬态干扰导致的位翻转，不损坏硬件。" },
    { "source_term": "single event upset", "target_term": "单粒子翻转", "domain": "hardware", "definition": "单个高能粒子击中存储单元引起的位翻转。" },
    { "source_term": "thermal throttling", "target_term": "热降频", "domain": "hardware", "definition": "温度超限时主动降低频率以免过热。" },
    { "source_term": "thermal design power", "target_term": "热设计功耗", "domain": "hardware", "definition": "散热系统需按此功率设计，并非实际最大功耗。" },
    { "source_term": "wire bonding", "target_term": "引线键合", "domain": "hardware", "definition": "用金属细线连接裸片焊盘与封装引脚。" },
    { "source_term": "flip-chip", "target_term": "倒装焊", "domain": "hardware", "definition": "裸片正面朝下、用凸点直接与基板连接。" },
    { "source_term": "through-silicon via", "target_term": "硅通孔", "domain": "hardware", "definition": "穿过硅片连接上下层芯片的垂直互连。" },
    { "source_term": "high bandwidth memory", "target_term": "高带宽存储器", "domain": "hardware", "definition": "多层 DRAM 堆叠并通过宽接口互连的显存方案。" },
    { "source_term": "memory controller", "target_term": "内存控制器", "domain": "hardware", "definition": "负责调度 DRAM 读写、刷新与地址映射的部件。" },
    { "source_term": "serializer/deserializer", "target_term": "串行器/解串器", "domain": "hardware", "definition": "在并行总线与高速串行链路之间转换数据。" },
    { "source_term": "phase-locked loop", "target_term": "锁相环", "domain": "hardware", "definition": "通过反馈使输出相位锁定参考时钟的频率合成电路。" },
    { "source_term": "delay-locked loop", "target_term": "延迟锁定环", "domain": "hardware", "definition": "用可调延时线对齐时钟相位，不改变频率。" },
    { "source_term": "bandgap reference", "target_term": "带隙基准", "domain": "hardware", "definition": "利用带隙电压产生低温漂参考电压的电路。" },
    { "source_term": "low-dropout regulator", "target_term": "低压差稳压器", "domain": "hardware", "definition": "输入输出压差很小时仍能稳定输出的线性稳压器。" },
    { "source_term": "analog-to-digital converter", "target_term": "模数转换器", "domain": "hardware", "definition": "把连续模拟信号量化为离散数字码。" },
    { "source_term": "digital-to-analog converter", "target_term": "数模转换器", "domain": "hardware", "definition": "把数字码转换为模拟电压或电流。" },
    { "source_term": "sample-and-hold circuit", "target_term": "采样保持电路", "domain": "hardware", "definition": "在采样瞬间保持模拟电压，供后续量化使用。" },
    { "source_term": "Nyquist frequency", "target_term": "奈奎斯特频率", "domain": "hardware", "definition": "采样率的一半，超过此频率的信号会发生混叠。" },
    { "source_term": "aliasing distortion", "target_term": "混叠失真", "domain": "hardware", "definition": "采样率不足时高频成分折叠到低频造成的失真。" },
    { "source_term": "quantization error", "target_term": "量化误差", "domain": "hardware", "definition": "连续值映射到有限离散码产生的舍入误差。" },
    { "source_term": "inter-integrated circuit bus", "target_term": "集成电路总线", "domain": "hardware", "definition": "两线制、主从结构的板级低速串行总线，即 I2C。" },
    { "source_term": "serial peripheral interface", "target_term": "串行外设接口", "domain": "hardware", "definition": "四线制全双工同步串行总线，即 SPI。" },
    { "source_term": "universal asynchronous receiver-transmitter", "target_term": "通用异步收发器", "domain": "hardware", "definition": "无需共享时钟、按约定波特率收发的串口电路。" },
    { "source_term": "direct memory access", "target_term": "直接内存访问", "domain": "hardware", "definition": "外设绕过 CPU 直接读写内存的数据搬运机制。" },
    { "source_term": "interrupt controller", "target_term": "中断控制器", "domain": "hardware", "definition": "汇集中断源、排定优先级并通知处理器的部件。" },
    { "source_term": "memory-mapped I/O", "target_term": "内存映射 I/O", "domain": "hardware", "definition": "把外设寄存器映射到地址空间，用访存指令访问。" },
    { "source_term": "register file", "target_term": "寄存器堆", "domain": "hardware", "definition": "处理器内由多端口寄存器组成的快速存储阵列。" },
    { "source_term": "instruction fetch", "target_term": "取指", "domain": "hardware", "definition": "按程序计数器从存储器读取指令的流水级。" },
