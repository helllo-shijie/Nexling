  "entries": [
    { "source_term": "eigenvalue", "target_term": "特征值", "domain": "mathematics", "definition": "满足 Ax=λx 的标量 λ；物理文献中也作“本征值”。" },
    { "source_term": "eigenvector", "target_term": "特征向量", "domain": "mathematics", "definition": "经线性变换后只改变长度、不改变方向的非零向量。" },
    { "source_term": "eigenspace", "target_term": "特征空间", "domain": "mathematics", "definition": "同一特征值对应的全部特征向量与零向量构成的子空间。" },
    { "source_term": "characteristic polynomial", "target_term": "特征多项式", "domain": "mathematics", "definition": "det(λI−A)，其根即矩阵的特征值。" },
    { "source_term": "diagonalization", "target_term": "对角化", "domain": "mathematics", "definition": "寻找可逆矩阵使 A 相似于对角矩阵。" },
    { "source_term": "Jordan canonical form", "target_term": "若尔当标准型", "domain": "mathematics", "definition": "不可对角化矩阵在相似意义下的最简形式。" },
    { "source_term": "singular value decomposition", "target_term": "奇异值分解", "domain": "mathematics", "definition": "把任意矩阵分解为两个正交矩阵与一个对角矩阵之积。" },
    { "source_term": "spectral radius", "target_term": "谱半径", "domain": "mathematics", "definition": "矩阵全部特征值绝对值的最大值。" },
    { "source_term": "spectral theorem", "target_term": "谱定理", "domain": "mathematics", "definition": "实对称或复埃尔米特矩阵可正交（酉）对角化。" },
    { "source_term": "positive definite matrix", "target_term": "正定矩阵", "domain": "mathematics", "definition": "对所有非零向量 x 都有 xᵀAx>0 的对称矩阵。" },
    { "source_term": "positive semidefinite matrix", "target_term": "半正定矩阵", "domain": "mathematics", "definition": "对所有向量 x 都有 xᵀAx≥0 的对称矩阵。" },
    { "source_term": "Hermitian matrix", "target_term": "埃尔米特矩阵", "domain": "mathematics", "definition": "等于自身共轭转置的复方阵。" },
    { "source_term": "unitary matrix", "target_term": "酉矩阵", "domain": "mathematics", "definition": "满足 U*U=I 的复方阵，保持内积与长度。" },
    { "source_term": "orthogonal matrix", "target_term": "正交矩阵", "domain": "mathematics", "definition": "满足 QᵀQ=I 的实方阵，其列向量构成标准正交基。" },
    { "source_term": "orthogonal projection", "target_term": "正交投影", "domain": "mathematics", "definition": "沿与子空间垂直的方向投影到该子空间。" },
    { "source_term": "Gram-Schmidt orthogonalization", "target_term": "格拉姆-施密特正交化", "domain": "mathematics", "definition": "把线性无关向量组逐步化为标准正交组的方法。" },
    { "source_term": "QR decomposition", "target_term": "QR 分解", "domain": "mathematics", "definition": "把矩阵分解为正交（酉）矩阵与上三角矩阵之积。" },
    { "source_term": "LU decomposition", "target_term": "LU 分解", "domain": "mathematics", "definition": "把矩阵分解为下三角与上三角矩阵之积，用于解线性方程组。" },
    { "source_term": "Cholesky decomposition", "target_term": "乔列斯基分解", "domain": "mathematics", "definition": "把正定矩阵分解为下三角矩阵与其转置之积。" },
    { "source_term": "rank-nullity theorem", "target_term": "秩-零化度定理", "domain": "mathematics", "definition": "线性映射的秩与零空间维数之和等于定义域维数。" },
    { "source_term": "null space", "target_term": "零空间", "domain": "mathematics", "definition": "被线性映射映为零向量的全部向量集合。" },
    { "source_term": "column space", "target_term": "列空间", "domain": "mathematics", "definition": "矩阵各列向量张成的子空间，即映射的像。" },
    { "source_term": "row space", "target_term": "行空间", "domain": "mathematics", "definition": "矩阵各行向量张成的子空间，维数等于矩阵的秩。" },
    { "source_term": "linear independence", "target_term": "线性无关", "domain": "mathematics", "definition": "不存在非平凡线性组合为零的向量组性质。" },
    { "source_term": "linear span", "target_term": "线性张成", "domain": "mathematics", "definition": "一组向量的全部有限线性组合构成的子空间。" },
    { "source_term": "basis vector", "target_term": "基向量", "domain": "mathematics", "definition": "张成向量空间且线性无关的一组向量中的成员。" },
    { "source_term": "linear transformation", "target_term": "线性变换", "domain": "mathematics", "definition": "保持向量加法与数乘运算的映射。" },
    { "source_term": "kernel of a linear map", "target_term": "线性映射的核", "domain": "mathematics", "definition": "被映射为零的向量集合；勿与“核心”混淆。" },
    { "source_term": "image of a linear map", "target_term": "线性映射的像", "domain": "mathematics", "definition": "映射所有可能输出构成的子空间。" },
    { "source_term": "dual space", "target_term": "对偶空间", "domain": "mathematics", "definition": "向量空间上全部线性泛函构成的空间。" },
    { "source_term": "inner product space", "target_term": "内积空间", "domain": "mathematics", "definition": "配有内积、可定义长度与夹角的向量空间。" },
    { "source_term": "Cauchy-Schwarz inequality", "target_term": "柯西-施瓦茨不等式", "domain": "mathematics", "definition": "内积绝对值不超过两向量范数之积。" },
    { "source_term": "triangle inequality", "target_term": "三角不等式", "domain": "mathematics", "definition": "两向量之和的范数不超过各自范数之和。" },
    { "source_term": "vector norm", "target_term": "向量范数", "domain": "mathematics", "definition": "衡量向量长度的非负函数，需满足齐次性与三角不等式。" },
    { "source_term": "metric space", "target_term": "度量空间", "domain": "mathematics", "definition": "配有距离函数、可谈论收敛与开集的集合。" },
    { "source_term": "complete metric space", "target_term": "完备度量空间", "domain": "mathematics", "definition": "每个柯西序列都收敛于空间内一点的度量空间。" },
    { "source_term": "Banach space", "target_term": "巴拿赫空间", "domain": "mathematics", "definition": "完备的赋范向量空间。" },
    { "source_term": "Hilbert space", "target_term": "希尔伯特空间", "domain": "mathematics", "definition": "完备的内积空间，常用于量子力学与信号处理。" },
    { "source_term": "compactness", "target_term": "紧性", "domain": "mathematics", "definition": "任意开覆盖都有有限子覆盖的拓扑性质。" },
    { "source_term": "uniform continuity", "target_term": "一致连续", "domain": "mathematics", "definition": "δ 只依赖于 ε、不依赖于点的连续性强于普通连续。" },
    { "source_term": "Lipschitz continuity", "target_term": "利普希茨连续性", "domain": "mathematics", "definition": "函数值变化被常数倍的自变量变化所控制。" },
    { "source_term": "total derivative", "target_term": "全导数", "domain": "mathematics", "definition": "多元函数沿所有方向变化的最优线性逼近。" },
    { "source_term": "partial derivative", "target_term": "偏导数", "domain": "mathematics", "definition": "固定其余变量、只对一个变量求导。" },
    { "source_term": "Jacobian matrix", "target_term": "雅可比矩阵", "domain": "mathematics", "definition": "向量值函数一阶偏导数组成的矩阵。" },
    { "source_term": "Hessian matrix", "target_term": "黑塞矩阵", "domain": "mathematics", "definition": "标量函数二阶偏导数组成的对称矩阵。" },
    { "source_term": "directional derivative", "target_term": "方向导数", "domain": "mathematics", "definition": "函数沿指定方向的变化率。" },
    { "source_term": "gradient", "target_term": "梯度", "domain": "mathematics", "definition": "各偏导数组成的向量，指向函数增长最快方向。" },
    { "source_term": "divergence", "target_term": "散度", "domain": "mathematics", "definition": "向量场在某点的源汇强度；勿与“分歧”混淆。" },
    { "source_term": "curl", "target_term": "旋度", "domain": "mathematics", "definition": "描述向量场局部旋转程度的向量。" },
    { "source_term": "Laplacian", "target_term": "拉普拉斯算子", "domain": "mathematics", "definition": "梯度的散度，记为 ∇²。" },
    { "source_term": "line integral", "target_term": "曲线积分", "domain": "mathematics", "definition": "沿曲线对函数或向量场积分。" },
    { "source_term": "surface integral", "target_term": "曲面积分", "domain": "mathematics", "definition": "在曲面上对函数或向量场积分。" },
    { "source_term": "Green's theorem", "target_term": "格林公式", "domain": "mathematics", "definition": "把平面区域上的二重积分与边界曲线积分联系起来。" },
    { "source_term": "Stokes' theorem", "target_term": "斯托克斯定理", "domain": "mathematics", "definition": "把曲面上的旋度积分与边界曲线积分联系起来。" },
    { "source_term": "divergence theorem", "target_term": "散度定理", "domain": "mathematics", "definition": "把体积内散度积分与边界面通量联系起来。" },
    { "source_term": "Taylor series", "target_term": "泰勒级数", "domain": "mathematics", "definition": "用某点各阶导数构造的幂级数展开。" },
    { "source_term": "Maclaurin series", "target_term": "麦克劳林级数", "domain": "mathematics", "definition": "在零点展开的泰勒级数。" },
    { "source_term": "radius of convergence", "target_term": "收敛半径", "domain": "mathematics", "definition": "幂级数绝对收敛的开区间半径。" },
    { "source_term": "uniform convergence", "target_term": "一致收敛", "domain": "mathematics", "definition": "收敛速度与自变量取值无关的函数列收敛。" },
    { "source_term": "pointwise convergence", "target_term": "逐点收敛", "domain": "mathematics", "definition": "每个固定点处的函数值列都收敛。" },
    { "source_term": "Fourier series", "target_term": "傅里叶级数", "domain": "mathematics", "definition": "把周期函数展开为正弦与余弦的无穷级数。" },
    { "source_term": "Fourier transform", "target_term": "傅里叶变换", "domain": "mathematics", "definition": "把时域函数分解为不同频率复指数分量。" },
    { "source_term": "Laplace transform", "target_term": "拉普拉斯变换", "domain": "mathematics", "definition": "把时域函数映射到复频域，常用于解微分方程。" },
    { "source_term": "convolution", "target_term": "卷积", "domain": "mathematics", "definition": "两个函数翻转平移后乘积的积分；信号处理中也称“褶积”。" },
    { "source_term": "Dirac delta function", "target_term": "狄拉克 δ 函数", "domain": "mathematics", "definition": "除原点外为零、积分为一的广义函数。" },
    { "source_term": "generalized function", "target_term": "广义函数", "domain": "mathematics", "definition": "以对测试函数的作用定义的函数推广，如 δ 函数。" },
