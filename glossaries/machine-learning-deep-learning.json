    { "source_term": "vocabulary", "target_term": "词表", "domain": "machine-learning", "definition": "模型可识别的全部词元集合。" },
    { "source_term": "language model", "target_term": "语言模型", "domain": "machine-learning", "definition": "建模词序列概率分布的模型。" },
