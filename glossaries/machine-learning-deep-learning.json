    { "source_term": "class imbalance", "target_term": "类别不平衡", "domain": "machine-learning", "definition": "各类样本数量差异悬殊，需重采样或改损失。" },
    { "source_term": "hyperparameter tuning", "target_term": "超参数调优", "domain": "machine-learning", "definition": "搜索学习率、层数等训练前设定的参数。" },
