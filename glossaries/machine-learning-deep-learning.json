    { "source_term": "transfer learning", "target_term": "迁移学习", "domain": "machine-learning", "definition": "把源任务学到的知识迁移到目标任务。" },
    { "source_term": "self-supervised learning", "target_term": "自监督学习", "domain": "machine-learning", "definition": "从数据本身构造监督信号进行预训练。" },
