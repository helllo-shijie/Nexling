    { "source_term": "variance", "target_term": "方差", "domain": "mathematics", "definition": "随机变量偏离期望的平方的期望。" },
    { "source_term": "covariance", "target_term": "协方差", "domain": "mathematics", "definition": "两个随机变量共同变化的程度。" },
    { "source_term": "conditional probability", "target_term": "条件概率", "domain": "mathematics", "definition": "已知事件 B 发生时事件 A 发生的概率。" },
    { "source_term": "Bayes' theorem", "target_term": "贝叶斯定理", "domain": "mathematics", "definition": "用先验与似然计算后验概率的公式。" },
    { "source_term": "law of large numbers", "target_term": "大数定律", "domain": "mathematics", "definition": "样本均值依概率收敛到期望值。" },
    { "source_term": "central limit theorem", "target_term": "中心极限定理", "domain": "mathematics", "definition": "独立同分布变量之和标准化后趋于正态分布。" },
    { "source_term": "martingale", "target_term": "鞅", "domain": "mathematics", "definition": "给定历史条件下下一步的条件期望等于当前值。" },
    { "source_term": "Markov chain", "target_term": "马尔可夫链", "domain": "mathematics", "definition": "下一状态只依赖当前状态、与更早历史无关的随机过程。" },
    { "source_term": "stationary distribution", "target_term": "平稳分布", "domain": "mathematics", "definition": "经状态转移后仍保持不变的概率分布。" },
    { "source_term": "ergodicity", "target_term": "遍历性", "domain": "mathematics", "definition": "时间平均以概率收敛到空间平均的性质。" },
    { "source_term": "generating function", "target_term": "生成函数", "domain": "mathematics", "definition": "把序列编码为幂级数系数、便于计数与递推分析。" },
    { "source_term": "analytic function", "target_term": "解析函数", "domain": "mathematics", "definition": "在每点邻域内可展开为收敛幂级数的复函数。" },
    { "source_term": "holomorphic function", "target_term": "全纯函数", "domain": "mathematics", "definition": "在开集内每点复可导的复函数。" },
