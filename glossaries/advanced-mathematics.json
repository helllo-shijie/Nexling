    { "source_term": "contour integral", "target_term": "围道积分", "domain": "mathematics", "definition": "沿复平面曲线的复变函数积分。" },
    { "source_term": "Cauchy-Riemann equations", "target_term": "柯西-黎曼方程", "domain": "mathematics", "definition": "复可导函数实部与虚部偏导数必须满足的关系。" },
    { "source_term": "conformal mapping", "target_term": "共形映射", "domain": "mathematics", "definition": "保持角度大小的复解析映射。" },
    { "source_term": "branch cut", "target_term": "分支割线", "domain": "mathematics", "definition": "为使多值函数单值化而人为去除的曲线。" },
