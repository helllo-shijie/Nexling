{
  "schema_version": "glossary-package/v1",
  "pack_id": "computer-networks",
  "name": "计算机网络",
  "description": "协议栈、传输层、路由、网络安全与数据中心网络常用术语；英译中单向，共 133 条。",
  "version": "1.0.0",
  "langs": ["en", "zh-Hans"],
  "domain": "networking",
  "license": "CC-BY-4.0",
  "attribution": "NexLing community glossary",
  "entry_count": 133,
  "entries": [
    { "source_term": "protocol stack", "target_term": "协议栈", "domain": "networking", "definition": "按层次组织的一组网络协议及其实现。" },
    { "source_term": "OSI model", "target_term": "OSI 模型", "domain": "networking", "definition": "七层网络参考模型，未直接对应实际协议实现。" },
    { "source_term": "encapsulation", "target_term": "封装", "domain": "networking", "definition": "上层数据加上本层首部后交给下层。" },
    { "source_term": "decapsulation", "target_term": "解封装", "domain": "networking", "definition": "接收方逐层剥离首部并把数据交给上层。" },
    { "source_term": "data frame", "target_term": "数据帧", "domain": "networking", "definition": "链路层的传输单位；勿与通用“框架”混淆。" },
    { "source_term": "maximum transmission unit", "target_term": "最大传输单元", "domain": "networking", "definition": "链路层一次可承载的最大载荷，即 MTU。" },
    { "source_term": "maximum segment size", "target_term": "最大报文段长度", "domain": "networking", "definition": "TCP 单段可携带的最大数据量，即 MSS。" },
    { "source_term": "packet switching", "target_term": "分组交换", "domain": "networking", "definition": "把数据切分为分组、按存储转发独立传输。" },
    { "source_term": "circuit switching", "target_term": "电路交换", "domain": "networking", "definition": "通信前建立专用通路并全程占用。" },
    { "source_term": "store-and-forward", "target_term": "存储转发", "domain": "networking", "definition": "节点收完整帧后再向下一跳转发。" },
    { "source_term": "queuing delay", "target_term": "排队时延", "domain": "networking", "definition": "分组在路由器缓冲区等待发送的时间。" },
    { "source_term": "propagation delay", "target_term": "传播时延", "domain": "networking", "definition": "信号在介质中传播所需时间，与带宽无关。" },
    { "source_term": "transmission delay", "target_term": "传输时延", "domain": "networking", "definition": "把比特推上链路所需时间，等于长度除以带宽。" },
    { "source_term": "round-trip time", "target_term": "往返时延", "domain": "networking", "definition": "从发送到收到确认的往返时间，即 RTT。" },
    { "source_term": "network jitter", "target_term": "网络抖动", "domain": "networking", "definition": "端到端时延的波动，影响实时音视频。" },
    { "source_term": "packet loss", "target_term": "丢包", "domain": "networking", "definition": "分组未能到达目的地，通常由拥塞或错误导致。" },
    { "source_term": "bandwidth-delay product", "target_term": "带宽时延积", "domain": "networking", "definition": "链路上“在途”比特量，决定窗口至少应有多大。" },
    { "source_term": "flow control", "target_term": "流量控制", "domain": "networking", "definition": "防止发送方压垮接收方缓冲的端到端机制。" },
    { "source_term": "congestion control", "target_term": "拥塞控制", "domain": "networking", "definition": "根据网络拥塞状况调整发送速率。" },
    { "source_term": "sliding window", "target_term": "滑动窗口", "domain": "networking", "definition": "允许连续发送多个未确认分组的机制。" },
    { "source_term": "selective repeat", "target_term": "选择重传", "domain": "networking", "definition": "只重传丢失的分组，接收方缓存乱序到达者。" },
    { "source_term": "go-back-N", "target_term": "回退 N", "domain": "networking", "definition": "从丢失分组起重传其后所有分组。" },
    { "source_term": "automatic repeat request", "target_term": "自动重传请求", "domain": "networking", "definition": "依靠确认与超时实现可靠传输，即 ARQ。" },
    { "source_term": "checksum", "target_term": "校验和", "domain": "networking", "definition": "对数据求和取反码以检测传输错误。" },
    { "source_term": "cyclic redundancy check", "target_term": "循环冗余校验", "domain": "networking", "definition": "用多项式除法余数检测比特错误，即 CRC。" },
    { "source_term": "parity bit", "target_term": "奇偶校验位", "domain": "networking", "definition": "附加一位使 1 的个数满足奇偶约定。" },
    { "source_term": "three-way handshake", "target_term": "三次握手", "domain": "networking", "definition": "TCP 建立连接时交换 SYN 与 ACK 的过程。" },
    { "source_term": "four-way handshake", "target_term": "四次挥手", "domain": "networking", "definition": "TCP 双方各发 FIN 与 ACK 以关闭双向连接。" },
    { "source_term": "sequence number", "target_term": "序列号", "domain": "networking", "definition": "标识字节流位置，用于排序与去重。" },
    { "source_term": "acknowledgment packet", "target_term": "确认报文", "domain": "networking", "definition": "告知发送方已正确收到数据的报文。" },
    { "source_term": "retransmission timeout", "target_term": "重传超时", "domain": "networking", "definition": "未收到确认后触发重传的等待时间。" },
    { "source_term": "fast retransmit", "target_term": "快速重传", "domain": "networking", "definition": "收到三个重复确认即重传，而不等超时。" },
    { "source_term": "slow start", "target_term": "慢启动", "domain": "networking", "definition": "拥塞窗口从很小开始按确认指数增长。" },
    { "source_term": "congestion avoidance", "target_term": "拥塞避免", "domain": "networking", "definition": "达到阈值后改为每轮线性增长窗口。" },
    { "source_term": "additive increase multiplicative decrease", "target_term": "加性增乘性减", "domain": "networking", "definition": "无丢包时线性增窗、丢包时减半，即 AIMD。" },
    { "source_term": "congestion window", "target_term": "拥塞窗口", "domain": "networking", "definition": "发送方根据网络拥塞估计可发送的未确认数据量。" },
    { "source_term": "receive window", "target_term": "接收窗口", "domain": "networking", "definition": "接收方通告的可用缓冲大小。" },
    { "source_term": "Nagle algorithm", "target_term": "纳格算法", "domain": "networking", "definition": "合并小数据以减少网络上的小包数量。" },
    { "source_term": "delayed acknowledgment", "target_term": "延迟确认", "domain": "networking", "definition": "推迟发送 ACK 以等待可捎带的数据。" },
    { "source_term": "head-of-line blocking", "target_term": "队头阻塞", "domain": "networking", "definition": "前一个分组受阻导致后续分组无法交付。" },
    { "source_term": "IP fragmentation", "target_term": "IP 分片", "domain": "networking", "definition": "把超过 MTU 的数据报拆分为多个分片。" },
    { "source_term": "reassembly", "target_term": "重组", "domain": "networking", "definition": "接收端按偏移把分片还原为完整数据报。" },
    { "source_term": "path MTU discovery", "target_term": "路径 MTU 发现", "domain": "networking", "definition": "探测整条路径可通过的最大传输单元。" },
    { "source_term": "subnet mask", "target_term": "子网掩码", "domain": "networking", "definition": "区分 IP 地址网络位与主机位的掩码。" },
    { "source_term": "classless inter-domain routing", "target_term": "无类别域间路由", "domain": "networking", "definition": "用前缀长度表示网络，即 CIDR。" },
    { "source_term": "longest prefix matching", "target_term": "最长前缀匹配", "domain": "networking", "definition": "转发时选择前缀最长、最具体的路由。" },
    { "source_term": "routing table", "target_term": "路由表", "domain": "networking", "definition": "保存目的网络与下一跳对应关系的表。" },
    { "source_term": "forwarding table", "target_term": "转发表", "domain": "networking", "definition": "数据平面按目的地址查表决定出端口。" },
    { "source_term": "autonomous system", "target_term": "自治系统", "domain": "networking", "definition": "由单一机构管理、采用统一路由策略的网络，即 AS。" },
    { "source_term": "border gateway protocol", "target_term": "边界网关协议", "domain": "networking", "definition": "自治系统之间交换路由信息的路径向量协议，即 BGP。" },
    { "source_term": "open shortest path first", "target_term": "开放最短路径优先", "domain": "networking", "definition": "基于链路状态与 Dijkstra 算法的域内路由协议，即 OSPF。" },
    { "source_term": "routing information protocol", "target_term": "路由信息协议", "domain": "networking", "definition": "以跳数为度量的距离向量路由协议，即 RIP。" },
    { "source_term": "link-state routing", "target_term": "链路状态路由", "domain": "networking", "definition": "各路由器泛洪链路状态并独立计算最短路径。" },
    { "source_term": "distance-vector routing", "target_term": "距离向量路由", "domain": "networking", "definition": "与邻居交换距离向量并迭代更新路由。" },
    { "source_term": "count-to-infinity problem", "target_term": "计数到无穷问题", "domain": "networking", "definition": "坏消息传播慢导致距离值逐步累加的收敛缺陷。" },
    { "source_term": "split horizon", "target_term": "水平分割", "domain": "networking", "definition": "不把路由信息回传给学习到它的邻居。" },
    { "source_term": "poison reverse", "target_term": "毒性逆转", "domain": "networking", "definition": "把回传路由的度量置为无穷，抑制环路。" },
    { "source_term": "equal-cost multipath", "target_term": "等价多路径", "domain": "networking", "definition": "在多条同代价路径间分摊流量，即 ECMP。" },
    { "source_term": "virtual LAN", "target_term": "虚拟局域网", "domain": "networking", "definition": "在交换机上按逻辑划分广播域，即 VLAN。" },
    { "source_term": "trunk port", "target_term": "干道端口", "domain": "networking", "definition": "承载多个 VLAN 标签帧的交换机端口。" },
    { "source_term": "access port", "target_term": "接入端口", "domain": "networking", "definition": "只属于一个 VLAN、面向终端的交换机端口。" },
    { "source_term": "spanning tree protocol", "target_term": "生成树协议", "domain": "networking", "definition": "阻塞冗余链路以避免二层环路，即 STP。" },
    { "source_term": "broadcast storm", "target_term": "广播风暴", "domain": "networking", "definition": "广播帧在环路中反复复制、耗尽带宽。" },
    { "source_term": "MAC address", "target_term": "MAC 地址", "domain": "networking", "definition": "链路层的硬件地址，通常 48 位。" },
    { "source_term": "address resolution protocol", "target_term": "地址解析协议", "domain": "networking", "definition": "由 IP 地址查询对应 MAC 地址，即 ARP。" },
    { "source_term": "gratuitous ARP", "target_term": "免费 ARP", "domain": "networking", "definition": "主机主动广播自身 IP-MAC 映射，用于冲突检测或更新。" },
    { "source_term": "dynamic host configuration protocol", "target_term": "动态主机配置协议", "domain": "networking", "definition": "自动分配 IP、掩码、网关与 DNS，即 DHCP。" },
    { "source_term": "domain name system", "target_term": "域名系统", "domain": "networking", "definition": "把域名解析为 IP 地址的分布式系统，即 DNS。" },
    { "source_term": "recursive resolver", "target_term": "递归解析器", "domain": "networking", "definition": "替客户端逐级查询并返回最终结果的 DNS 服务器。" },
    { "source_term": "authoritative name server", "target_term": "权威域名服务器", "domain": "networking", "definition": "保存某区域权威记录、给出最终答案的服务器。" },
    { "source_term": "time to live", "target_term": "生存时间", "domain": "networking", "definition": "IP 首部中限制跳数的字段，也指 DNS 缓存时长。" },
    { "source_term": "canonical name record", "target_term": "规范名称记录", "domain": "networking", "definition": "把一个域名指向另一个域名的 DNS 记录，即 CNAME。" },
    { "source_term": "AAAA record", "target_term": "AAAA 记录", "domain": "networking", "definition": "把域名映射到 IPv6 地址的 DNS 记录。" },
    { "source_term": "network address translation", "target_term": "网络地址转换", "domain": "networking", "definition": "在私有与公网地址之间改写首部，即 NAT。" },
    { "source_term": "port forwarding", "target_term": "端口转发", "domain": "networking", "definition": "把公网端口流量转发到内网主机端口。" },
    { "source_term": "stateful inspection", "target_term": "状态检测", "domain": "networking", "definition": "防火墙跟踪连接状态以判断是否放行。" },
    { "source_term": "access control list", "target_term": "访问控制列表", "domain": "networking", "definition": "按规则顺序匹配并允许或拒绝流量的列表，即 ACL。" },
    { "source_term": "virtual private network", "target_term": "虚拟专用网", "domain": "networking", "definition": "在公共网络上建立加密隧道的逻辑专网，即 VPN。" },
    { "source_term": "TLS handshake", "target_term": "TLS 握手", "domain": "networking", "definition": "协商版本与密钥、验证证书并建立加密通道。" },
    { "source_term": "certificate chain", "target_term": "证书链", "domain": "networking", "definition": "从服务器证书逐级到受信根证书的签发关系。" },
    { "source_term": "certificate authority", "target_term": "证书颁发机构", "domain": "networking", "definition": "签发并担保数字证书可信的机构，即 CA。" },
    { "source_term": "server name indication", "target_term": "服务器名称指示", "domain": "networking", "definition": "TLS 客户端在握手时声明要访问的域名，即 SNI。" },
    { "source_term": "application-layer protocol negotiation", "target_term": "应用层协议协商", "domain": "networking", "definition": "TLS 握手时选择 HTTP/2 或 HTTP/1.1，即 ALPN。" },
    { "source_term": "QUIC protocol", "target_term": "QUIC 协议", "domain": "networking", "definition": "基于 UDP、内置 TLS 与多路复用的传输协议。" },
    { "source_term": "stream multiplexing", "target_term": "流多路复用", "domain": "networking", "definition": "在一条连接上并发传输多个独立流。" },
    { "source_term": "reverse proxy", "target_term": "反向代理", "domain": "networking", "definition": "代表服务器接收请求并转发到后端。" },
    { "source_term": "forward proxy", "target_term": "正向代理", "domain": "networking", "definition": "代表客户端向外部服务器发起请求。" },
    { "source_term": "load balancer", "target_term": "负载均衡器", "domain": "networking", "definition": "把流量按策略分发到多个后端实例。" },
    { "source_term": "content delivery network", "target_term": "内容分发网络", "domain": "networking", "definition": "把内容缓存到离用户更近的边缘节点，即 CDN。" },
    { "source_term": "anycast", "target_term": "任播", "domain": "networking", "definition": "同一地址宣告于多地，路由到最近实例。" },
    { "source_term": "unicast", "target_term": "单播", "domain": "networking", "definition": "一对一发送数据。" },
    { "source_term": "multicast", "target_term": "组播", "domain": "networking", "definition": "一次发送、仅组内成员接收。" },
    { "source_term": "broadcast", "target_term": "广播", "domain": "networking", "definition": "向同一广播域内所有主机发送。" },
    { "source_term": "subnetting", "target_term": "子网划分", "domain": "networking", "definition": "借主机位作为网络位以拆分地址空间。" },
    { "source_term": "supernetting", "target_term": "超网合并", "domain": "networking", "definition": "把多个连续子网聚合为一个更大的前缀。" },
    { "source_term": "virtual extensible LAN", "target_term": "虚拟可扩展局域网", "domain": "networking", "definition": "用 UDP 封装二层帧以跨三层网络扩展 VLAN，即 VXLAN。" },
    { "source_term": "overlay network", "target_term": "覆盖网络", "domain": "networking", "definition": "在物理网络之上用隧道构建的逻辑网络。" },
    { "source_term": "software-defined networking", "target_term": "软件定义网络", "domain": "networking", "definition": "把控制平面集中化、用软件编排转发策略，即 SDN。" },
    { "source_term": "control plane", "target_term": "控制平面", "domain": "networking", "definition": "计算路由与策略、下发转发表的部分。" },
    { "source_term": "data plane", "target_term": "数据平面", "domain": "networking", "definition": "按转发表实际处理报文的部分。" },
    { "source_term": "multiprotocol label switching", "target_term": "多协议标签交换", "domain": "networking", "definition": "用短标签而非完整地址指导转发，即 MPLS。" },
    { "source_term": "traffic shaping", "target_term": "流量整形", "domain": "networking", "definition": "缓冲并平滑发送速率以符合约定。" },
    { "source_term": "token bucket", "target_term": "令牌桶", "domain": "networking", "definition": "以令牌生成速率限制平均带宽并允许突发。" },
    { "source_term": "leaky bucket", "target_term": "漏桶", "domain": "networking", "definition": "以恒定速率输出、削平突发流量。" },
    { "source_term": "quality of service", "target_term": "服务质量", "domain": "networking", "definition": "按业务需求保障带宽、时延与丢包，即 QoS。" },
    { "source_term": "differentiated services", "target_term": "区分服务", "domain": "networking", "definition": "按 DSCP 标记对流量分类并区别对待，即 DiffServ。" },
    { "source_term": "explicit congestion notification", "target_term": "显式拥塞通知", "domain": "networking", "definition": "路由器标记拥塞位、由接收方回传以通知发送方，即 ECN。" },
    { "source_term": "active queue management", "target_term": "主动队列管理", "domain": "networking", "definition": "在队列满前主动丢包或标记以提示拥塞，即 AQM。" },
    { "source_term": "zero-copy", "target_term": "零拷贝", "domain": "networking", "definition": "避免数据在内核与用户态间多次复制的传输优化。" },
    { "source_term": "ephemeral port", "target_term": "临时端口", "domain": "networking", "definition": "客户端连接时由系统临时分配的源端口。" },
    { "source_term": "TIME_WAIT state", "target_term": "TIME_WAIT 状态", "domain": "networking", "definition": "主动关闭方等待 2MSL 以处理迟到报文的状态。" },
    { "source_term": "TCP backlog", "target_term": "TCP 积压队列", "domain": "networking", "definition": "已完成握手但尚未被应用 accept 的连接队列。" },
    { "source_term": "keepalive", "target_term": "保活", "domain": "networking", "definition": "定期发送探测以确认连接仍然可用。" },
    { "source_term": "asymmetric routing", "target_term": "非对称路由", "domain": "networking", "definition": "去程与回程经过不同路径，可能导致状态防火墙丢包。" },
    { "source_term": "hairpin NAT", "target_term": "发夹 NAT", "domain": "networking", "definition": "内网主机通过公网地址访问同一内网服务的地址转换。" },
    { "source_term": "BGP hijacking", "target_term": "BGP 劫持", "domain": "networking", "definition": "恶意宣告他人前缀以劫持流量。" },
    { "source_term": "distributed denial of service", "target_term": "分布式拒绝服务", "domain": "networking", "definition": "利用大量分布式主机耗尽目标资源，即 DDoS。" },
    { "source_term": "SYN flood", "target_term": "SYN 洪泛", "domain": "networking", "definition": "大量伪造 SYN 耗尽半连接队列。" },
    { "source_term": "amplification attack", "target_term": "放大攻击", "domain": "networking", "definition": "利用小请求触发大响应，放大攻击流量。" },
    { "source_term": "network topology", "target_term": "网络拓扑", "domain": "networking", "definition": "节点与链路的连接结构。" },
