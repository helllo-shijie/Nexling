    { "source_term": "sigma-algebra", "target_term": "σ-代数", "domain": "mathematics", "definition": "对补集与可数并封闭的集合族，是测度的定义域。" },
    { "source_term": "Radon-Nikodym derivative", "target_term": "拉东-尼科迪姆导数", "domain": "mathematics", "definition": "两个测度之间的密度函数。" },
    { "source_term": "probability space", "target_term": "概率空间", "domain": "mathematics", "definition": "样本空间、事件 σ-代数与概率测度构成的三元组。" },
    { "source_term": "random variable", "target_term": "随机变量", "domain": "mathematics", "definition": "从样本空间到实数的可测函数。" },
