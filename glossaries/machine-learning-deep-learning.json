    { "source_term": "hallucination", "target_term": "幻觉", "domain": "machine-learning", "definition": "模型生成看似合理但与事实不符的内容。" },
    { "source_term": "prompt engineering", "target_term": "提示工程", "domain": "machine-learning", "definition": "设计输入提示以稳定获得期望输出。" },
