    { "source_term": "policy gradient", "target_term": "策略梯度", "domain": "machine-learning", "definition": "直接对策略参数求梯度以最大化期望回报。" },
    { "source_term": "Q-learning", "target_term": "Q 学习", "domain": "machine-learning", "definition": "基于贝尔曼方程学习状态-动作价值函数的算法。" },
    { "source_term": "reward shaping", "target_term": "奖励塑形", "domain": "machine-learning", "definition": "设计附加奖励以引导学习、加快收敛。" },
